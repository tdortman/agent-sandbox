#!/usr/bin/env bash
set -euo pipefail

# Check every push; publish the built package to Cachix when pushing to main.
CACHE_NAME="agent-sandbox"

push_to_main=""
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        push_to_main="main"
    fi
done

cd "$(git rev-parse --show-toplevel)"
echo "pre-push: running cargo clippy-strict and nix flake check ..." >&2
cargo clippy-strict
nix flake check

[[ -n "$push_to_main" ]] || exit 0

if ! command -v cachix >/dev/null 2>&1; then
    echo "pre-push: cachix missing, skipping binary cache push" >&2
    exit 0
fi

echo "pre-push: building and pushing to cachix $CACHE_NAME ..." >&2
out="$(nix build .# --no-link --print-out-paths)"
cachix push "$CACHE_NAME" "$out"
