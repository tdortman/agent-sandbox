 #[test]
+fn connection_id_events_track_authenticated_rotation_and_migration() {
+    let _guard = subscribe();
+    let mut pair = Pair::default();
+    let (client_ch, server_ch) = pair.connect();
+
+    let initial = drain_connection_id_events(pair.server_conn_mut(server_ch));
+    assert!(initial.iter().any(|event| {
+        matches!(
+            event,
+            ConnectionIdEvent::Active { sequence: 0, .. }
+        )
+    }));
+    assert!(initial.iter().all(|event| {
+        matches!(event, ConnectionIdEvent::Active { .. })
+    }));
+
+    let now = pair.time;
+    pair.server_conn_mut(server_ch).rotate_local_cid(1, now);
+    pair.drive();
+
+    let rotated = drain_connection_id_events(pair.server_conn_mut(server_ch));
+    assert!(rotated
+        .iter()
+        .any(|event| matches!(event, ConnectionIdEvent::Active { sequence, .. } if *sequence > 0)));
+    assert!(rotated
+        .iter()
+        .any(|event| matches!(event, ConnectionIdEvent::Retired { sequence: 0, .. })));
+
+    let client_addr = pair.client.addr;
+    pair.client.addr = SocketAddr::new(
+        Ipv6Addr::LOCALHOST.into(),
+        CLIENT_PORTS.lock().unwrap().next().unwrap(),
+    );
+    pair.client_conn_mut(client_ch).ping();
+    pair.drive();
+    pair.client.addr = client_addr;
+
+    assert!(drain_connection_id_events(pair.server_conn_mut(server_ch)).is_empty());
+}
+
+fn drain_connection_id_events(connection: &mut Connection) -> Vec<ConnectionIdEvent> {
+    let mut events = Vec::new();
+    while let Some(event) = connection.poll_connection_id_event() {
+        events.push(event);
+    }
+    events
+}
