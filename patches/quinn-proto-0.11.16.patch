 use crate::{Instant, MAX_CID_SIZE, ResetToken, coding::BufExt, packet::PartialDecode};
 
+/// A change to the set of locally-issued connection IDs.
+///
+/// These events describe the connection IDs that the local endpoint accepts in
+/// incoming packet headers. `Active` and `Retired` are emitted only after the
+/// connection has processed authenticated protocol state; `Removed` describes
+/// IDs discarded during connection teardown.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ConnectionIdEvent {
+    /// A connection ID was added to the active routing set.
+    Active {
+        /// The sequence number assigned to this connection ID.
+        sequence: u64,
+        /// The newly active connection ID.
+        id: ConnectionId,
+    },
+    /// A peer-authenticated `RETIRE_CONNECTION_ID` removed this ID.
+    Retired {
+        /// The sequence number assigned to this connection ID.
+        sequence: u64,
+        /// The retired connection ID.
+        id: ConnectionId,
+    },
+    /// The connection was torn down and this ID is no longer routable.
+    Removed {
+        /// The sequence number assigned to this connection ID.
+        sequence: u64,
+        /// The removed connection ID.
+        id: ConnectionId,
+    },
+}
