+#[test]
+fn connection_id_events_report_removed_ids_on_teardown() {
+    let _guard = subscribe();
+    let mut pair = Pair::default();
+    let (_, server_ch) = pair.connect();
+
+    assert!(!drain_connection_id_events(pair.server_conn_mut(server_ch)).is_empty());
+    let now = pair.time;
+    pair.server_conn_mut(server_ch)
+        .close(now, VarInt(42), Bytes::new());
+    pair.drive();
+
+    let removed = drain_connection_id_events(pair.server_conn_mut(server_ch));
+    assert!(removed
+        .iter()
+        .any(|event| matches!(event, ConnectionIdEvent::Removed { .. })));
+}
