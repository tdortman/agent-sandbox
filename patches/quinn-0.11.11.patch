+    /// Return the next authenticated change to the locally-issued CID set.
+    ///
+    /// The returned events describe the connection IDs accepted by this
+    /// endpoint. `Active` events are emitted after authentication and
+    /// `Retired` events only follow a valid peer `RETIRE_CONNECTION_ID` frame.
+    /// `Removed` events describe IDs discarded during connection teardown.
+    ///
+    /// The queue is owned by the connection and should be drained by the
+    /// application that owns this connection. The event's connection is the
+    /// one identified by [`stable_id`](Self::stable_id).
+    #[must_use]
+    pub fn poll_connection_id_event(&self) -> Option<proto::ConnectionIdEvent> {
+        self.0
+            .state
+            .lock("poll_connection_id_event")
+            .inner
+            .poll_connection_id_event()
+    }
+
