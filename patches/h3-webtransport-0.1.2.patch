+/// Accept an incoming WebTransport bidirectional stream.
+pub async fn accept_bidi<S, B>(stream: S) -> Result<(SessionId, BidiStream<S, B>), StreamError>
+where
+    S: quic::BidiStream<B>,
+    B: Buf,
+{
+    let mut frame_stream = FrameStream::new(BufRecvStream::new(stream));
+    let frame = poll_fn(|context| frame_stream.poll_next(context))
+        .await
+        .map_err(|error| StreamError::StreamError {
+            code: Code::H3_MESSAGE_ERROR,
+            reason: format!("invalid WebTransport stream header: {error:?}"),
+        })?;
+
+    match frame {
+        Some(Frame::WebTransportStream(session_id)) => {
+            Ok((session_id, BidiStream::new(frame_stream.into_inner())))
+        }
+        _ => Err(StreamError::StreamError {
+            code: Code::H3_MESSAGE_ERROR,
+            reason: "missing WebTransport stream header".to_string(),
+        }),
+    }
+}
